{
  "name": "nertator-web",
  "version": "0.1.0",
  "private": true,
  "description": "NERTator — web app version: a local Node/Express + SQLite server with a browser UI.",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:vite-dev\" \"npm:server-dev\"",
    "vite-dev": "vite",
    "server-dev": "node server/index.cjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.59.0",
    "@agentclientprotocol/codex-acp": "^1.1.4",
    "@agentclientprotocol/sdk": "^1.2.1",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/openai": "^1.5.5",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "openai": "^4.79.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
